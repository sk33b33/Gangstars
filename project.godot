; Engine configuration file. Gangstars — Godot 4.5.1 (see docs/TECH_NOTES.md)
config_version=5

[application]

config/name="Gangstars"
config/description="3D neighbourhood crime-and-empire game. Starter district: Westridge."
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[importer_defaults]

texture={
"compress/mode": 0,
"detect_3d/compress_to": 0,
"mipmaps/generate": true
}

[input]

move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":87),Object(InputEventJoypadMotion,"device":-1,"axis":1,"axis_value":-1.0)]
}
move_backward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":83),Object(InputEventJoypadMotion,"device":-1,"axis":1,"axis_value":1.0)]
}
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":65),Object(InputEventJoypadMotion,"device":-1,"axis":0,"axis_value":-1.0)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":68),Object(InputEventJoypadMotion,"device":-1,"axis":0,"axis_value":1.0)]
}
look_left={
"deadzone": 0.2,
"events": [Object(InputEventJoypadMotion,"device":-1,"axis":2,"axis_value":-1.0)]
}
look_right={
"deadzone": 0.2,
"events": [Object(InputEventJoypadMotion,"device":-1,"axis":2,"axis_value":1.0)]
}
look_up={
"deadzone": 0.2,
"events": [Object(InputEventJoypadMotion,"device":-1,"axis":3,"axis_value":-1.0)]
}
look_down={
"deadzone": 0.2,
"events": [Object(InputEventJoypadMotion,"device":-1,"axis":3,"axis_value":1.0)]
}
sprint={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194325),Object(InputEventJoypadButton,"device":-1,"button_index":7)]
}
jump={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":32),Object(InputEventJoypadButton,"device":-1,"button_index":1)]
}
interact={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":69),Object(InputEventJoypadButton,"device":-1,"button_index":0)]
}
pause={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194305),Object(InputEventJoypadButton,"device":-1,"button_index":6)]
}
toggle_debug={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194334)]
}
debug_reachability={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194335)]
}
shout={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":81),Object(InputEventJoypadButton,"device":-1,"button_index":3)]
}
debug_incident={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194336)]
}
debug_danger={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194337)]
}
debug_time={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194338)]
}
accelerate={
"deadzone": 0.1,
"events": [Object(InputEventJoypadMotion,"resource_local_to_scene":false,"resource_name":"","device":-1,"axis":5,"axis_value":1.0,"script":null)]
}
brake={
"deadzone": 0.1,
"events": [Object(InputEventJoypadMotion,"resource_local_to_scene":false,"resource_name":"","device":-1,"axis":4,"axis_value":1.0,"script":null)]
}
ui_accept={
"deadzone": 0.5,
"events": [Object(InputEventKey,"device":-1,"keycode":4194309), Object(InputEventKey,"device":-1,"keycode":4194310), Object(InputEventKey,"device":-1,"keycode":32), Object(InputEventJoypadButton,"device":-1,"button_index":0,"pressed":true)]
}
ui_cancel={
"deadzone": 0.5,
"events": [Object(InputEventKey,"device":-1,"keycode":4194305), Object(InputEventJoypadButton,"device":-1,"button_index":1,"pressed":true)]
}
aim={
"deadzone": 0.3,
"events": [Object(InputEventMouseButton,"device":-1,"button_index":2,"pressed":true), Object(InputEventJoypadMotion,"device":-1,"axis":4,"axis_value":1.0)]
}
fire={
"deadzone": 0.3,
"events": [Object(InputEventMouseButton,"device":-1,"button_index":1,"pressed":true), Object(InputEventJoypadMotion,"device":-1,"axis":5,"axis_value":1.0)]
}
switch_weapon={
"deadzone": 0.5,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194306), Object(InputEventJoypadButton,"device":-1,"button_index":10,"pressed":true)]
}
radio={
"deadzone": 0.5,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":82), Object(InputEventJoypadButton,"device":-1,"button_index":12,"pressed":true)]
}
phone={
"deadzone": 0.5,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":80), Object(InputEventJoypadButton,"device":-1,"button_index":11,"pressed":true)]
}
turf_map={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":77),Object(InputEventJoypadButton,"device":-1,"button_index":4)]
}
skip_tips={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194306),Object(InputEventJoypadButton,"device":-1,"button_index":13)]
}

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="npcs"
3d_physics/layer_4="interactables"
3d_physics/layer_5="vehicles"
3d_physics/layer_6="traffic"

[physics]

common/physics_ticks_per_second=60
common/physics_interpolation=true

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
renderer/rendering_method.web="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
