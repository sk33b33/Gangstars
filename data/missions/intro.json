        {
          "id": "kwikkie",
          "type": "knock",
          "target": "starter_h19",
          "text": "Deliver to 5 Kwikkie Street"
        },
        {
          "id": "tortel",
          "type": "knock",
          "target": "starter_h25",
          "text": "Deliver to 5 Tortel Lane"
        },
        {
          "id": "back",
          "type": "talk_to",
          "target": "npc_h12_1",
          "allow_knock": true,
          "text": "Tell Achmat it's done (8 Mossie Street)"
        }
      ],
      "rewards": {
        "cash": 90,
        "reputation": 6,
        "influence": {
          "starter": 3
        },
        "relationship": {
          "npc_h12_1": 10,
          "npc_h19_1": 5,
          "npc_h25_1": 5
        }
