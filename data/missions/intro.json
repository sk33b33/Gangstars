      "title": "New Face",
      "auto_start": true,
      "description": "You've just moved into 13 Duif Street. Introduce yourself to the street.",
      "objectives": [
        {
          "id": "meet_boeta",
          "type": "talk_to",
          "target": "npc_boeta",
          "allow_knock": true,
          "text": "Say hello to Boeta Daniels (5 Duif Street)"
        }
      ],
      "rewards": {
        "cash": 50,
        "reputation": 5,
        "relationship": {
          "npc_boeta": 10
        }
      }
    },
    {
