      "giver": "npc_faiza",
      "prerequisites": {
        "missions": [
          "new_face"
        ]
      },
      "intro": "Auntie Faiza: \"You're the new one at No. 13? Do me a favour, take this note to the Cupidos at 8 Mossie Street. Before supper, hey!\"",
      "description": "Deliver Auntie Faiza's note.",
      "time_limit_minutes": 240,
      "fail_text": "The note went stale. Auntie Faiza is not impressed.",
      "objectives": [
        {
          "id": "deliver",
          "type": "knock",
          "target": "starter_h12",
          "text": "Deliver the note: knock at 8 Mossie Street"
        },
        {
          "id": "return",
          "type": "talk_to",
          "target": "npc_faiza",
          "allow_knock": true,
          "text": "Tell Auntie Faiza it's done"
        }
      ],
      "rewards": {
        "cash": 80,
        "reputation": 10,
        "relationship": {
          "npc_faiza": 15,
          "npc_h12_1": 5
        },
        "influence": {
          "starter": 5
        }
      }
    },
